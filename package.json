{
  "name": "nivo-3d",
  "version": "1.0.0",
  "description": "Universal 3D Spatial Experience Component for React, Next.js, and Astro",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && vite build",
    "clean": "node -e \"fs.rmSync('dist', { recursive: true, force: true })\"",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/package.test.ts",
    "prepublishOnly": "npm run build && npm test",
    "pack:dry": "npm pack --dry-run"
  },
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://nivo.jonave.in",
  "repository": {
    "type": "git",
    "url": "https://github.com/jonave-official/nivo-3d.git"
  },
  "bugs": {
    "url": "https://github.com/jonave-official/nivo-3d/issues"
  },
  "keywords": [
    "3d",
    "threejs",
    "react-three-fiber",
    "webgl",
    "nivo",
    "spatial",
    "nextjs",
    "astro",
    "rsc",
    "creative-web"
  ],
  "author": "Jonave Technologies LLC / Nivo Contributors (https://nivo.jonave.in)",
  "license": "MIT",
  "peerDependencies": {
    "@react-three/drei": ">=9.0.0 || >=10.0.0",
    "@react-three/fiber": ">=8.0.0 || >=9.0.0",
    "react": ">=18.0.0 || >=19.0.0",
    "react-dom": ">=18.0.0 || >=19.0.0",
    "three": ">=0.155.0 || >=0.160.0 || >=0.180.0"
  },
  "devDependencies": {
    "@react-three/drei": "^9.100.0",
    "@react-three/fiber": "^8.16.0",
    "@types/node": "^20.11.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@types/three": "^0.160.0",
    "@vitejs/plugin-react": "^4.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.160.0",
    "tsx": "^4.7.0",
    "typescript": "^5.4.0",
    "vite": "^5.4.0"
  }
}
